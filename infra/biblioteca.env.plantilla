# /etc/biblioteca/biblioteca.env   (sudo chmod 600: solo lo lee root; systemd lo carga al arrancar)
# Plantilla SIN secretos: en la instancia sustituye <CAMBIAR> por la contraseña real de biblioteca_app.
JAVA_OPTS=-Xms128m -Xmx384m
BIBLIOTECA_DB_USER=biblioteca_app
BIBLIOTECA_DB_PASSWORD=<CAMBIAR>
BIBLIOTECA_ALUMNO=Raul Galera Canet
# Variante 3
BIBLIOTECA_PRESTAMO_MAXIMO=5
BIBLIOTECA_PRESTAMO_DIAS=30
